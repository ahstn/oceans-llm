{
  "name": "@oceans-llm/review-agent-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint -c ../.oxlintrc.json src scripts",
    "fmt": "oxfmt -c ../.oxfmtrc.json src scripts config",
    "fmt:check": "oxfmt -c ../.oxfmtrc.json --check src scripts config",
    "smoke": "node --import tsx scripts/smoke-search.ts && node --import tsx scripts/smoke-sdk.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "pi-intercom": "0.17.0",
    "pi-subagents": "0.77.0",
    "pi-web-access": "0.39.0",
    "tsx": "4.21.0",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@types/node": "25.9.4",
    "bun-types": "1.4.2",
    "typescript": "6.0.3",
    "oxlint": "1.78.0",
    "oxfmt": "0.63.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
