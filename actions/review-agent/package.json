{
  "name": "@oceans-llm/review-agent-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint -c ../.oxlintrc.json src scripts",
    "fmt": "oxfmt -c ../.oxfmtrc.json src scripts config",
    "fmt:check": "oxfmt -c ../.oxfmtrc.json --check src scripts config",
    "smoke": "node --import tsx scripts/smoke-search.ts && node --import tsx scripts/smoke-sdk.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "pi-intercom": "0.18.1",
    "pi-subagents": "0.89.1",
    "pi-web-access": "0.48.0",
    "tsx": "4.23.15",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "bun-types": "1.4.4",
    "typescript": "7.0.2",
    "oxlint": "1.93.0",
    "oxfmt": "0.78.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
