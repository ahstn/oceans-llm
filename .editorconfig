# Shared whitespace rules for editors and agents. Language formatters (rustfmt,
# oxfmt, taplo) own layout within their files; this covers everything else.
# `mise run editorconfig-check` enforces it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py}]
indent_size = 4

# Empty list items and checkboxes keep a trailing space so typing continues after it.
[.github/ISSUE_TEMPLATE/*.md]
trim_trailing_whitespace = false
