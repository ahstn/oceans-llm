{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "oceans",
  "homepage": "https://docs.oceans-llm.com",
  "items": [
    {
      "name": "oceans-theme",
      "type": "registry:theme",
      "title": "Oceans Gateway",
      "description": "The Oceans Gateway admin theme: Reef surfaces, Tokyo Night lilac for actions and Tokyo Night colours for data and status. Dark only.",
      "docs": "Dark only: keep class=\"dark\" on <html>, which these tokens target. The type utilities use Geist; install @fontsource-variable/geist and import it, or swap --font-sans. Generated from crates/admin-ui/web/src/styles/globals.css by scripts/build-shadcn-theme.mjs; DESIGN.md describes how to use each token.",
      "cssVars": {
        "theme": {
          "font-sans": "'Geist Variable', ui-sans-serif, sans-serif",
          "font-heading": "'Geist Variable', ui-sans-serif, sans-serif",
          "color-sidebar-ring": "var(--sidebar-ring)",
          "color-sidebar-border": "var(--sidebar-border)",
          "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
          "color-sidebar-accent": "var(--sidebar-accent)",
          "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
          "color-sidebar-primary": "var(--sidebar-primary)",
          "color-sidebar-foreground": "var(--sidebar-foreground)",
          "color-sidebar": "var(--sidebar)",
          "color-chart-5": "var(--chart-5)",
          "color-chart-4": "var(--chart-4)",
          "color-chart-3": "var(--chart-3)",
          "color-chart-2": "var(--chart-2)",
          "color-chart-1": "var(--chart-1)",
          "color-chart-other": "var(--chart-other)",
          "color-chart-hero": "var(--chart-hero)",
          "color-heatmap-0": "var(--heatmap-0)",
          "color-heatmap-1": "var(--heatmap-1)",
          "color-heatmap-2": "var(--heatmap-2)",
          "color-heatmap-3": "var(--heatmap-3)",
          "color-heatmap-4": "var(--heatmap-4)",
          "color-ring": "var(--ring)",
          "color-input": "var(--input)",
          "color-border": "var(--border)",
          "color-destructive": "var(--destructive)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-accent": "var(--accent)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-muted": "var(--muted)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-primary": "var(--primary)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-popover": "var(--popover)",
          "color-card-foreground": "var(--card-foreground)",
          "color-card": "var(--card)",
          "color-foreground": "var(--foreground)",
          "color-background": "var(--background)",
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)",
          "color-invert-foreground": "var(--invert-foreground)",
          "color-invert": "var(--invert)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-warning": "var(--warning)",
          "color-success-foreground": "var(--success-foreground)",
          "color-success": "var(--success)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-subtle-foreground": "color-mix(in oklch, var(--foreground) 72%, var(--muted-foreground) 28%)",
          "color-surface-muted": "var(--surface-muted)",
          "color-wave-deep": "var(--wave-deep)",
          "color-wave-foam": "var(--wave-foam)",
          "color-mist": "var(--mist)",
          "tracking-label": "0.08em",
          "tracking-eyebrow": "0.18em",
          "text-2xs": "0.625rem",
          "text-display": "clamp(2.8rem, 5vw, 4.6rem)",
          "text-display--line-height": "0.94",
          "text-display-sm": "clamp(1.9rem, 2vw, 2.6rem)",
          "shadow-sticky-edge": "8px 0 12px -12px rgb(0 0 0 / 0.8)",
          "shadow-sticky-edge-end": "-8px 0 12px -12px rgb(0 0 0 / 0.8)",
          "shadow-panel": "0 8px 24px -12px rgb(0 0 0 / 0.6)",
          "shadow-popover": "0 12px 28px -8px rgb(0 0 0 / 0.55)",
          "shadow-dialog": "0 24px 64px -16px rgb(0 0 0 / 0.7)",
          "inset-shadow-highlight": "inset 0 1px 0 rgb(255 255 255 / 0.05)",
          "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
          "ease-emphasized": "cubic-bezier(0.22, 1, 0.36, 1)",
          "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
          "animate-page-in": "page-in var(--duration-base) cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        "light": {
          "panel-glow": "radial-gradient(900px 300px at 50% -60px, rgb(1 111 159 / 0.24), transparent)",
          "radius": "0.45rem",
          "duration-fast": "120ms",
          "duration-base": "200ms",
          "duration-slow": "320ms",
          "duration-chart": "600ms"
        },
        "dark": {
          "sidebar": "#040c15",
          "background": "#07111c",
          "card": "#0c1a29",
          "popover": "#0e2133",
          "secondary": "#102336",
          "muted": "#0c1f31",
          "accent": "#0d2841",
          "surface-muted": "#0c1e2f",
          "foreground": "#e8edf3",
          "card-foreground": "#e8edf3",
          "popover-foreground": "#e8edf3",
          "secondary-foreground": "#e8edf3",
          "accent-foreground": "#e8edf3",
          "muted-foreground": "#94a7bb",
          "primary": "#bb9af7",
          "primary-foreground": "#040c15",
          "ring": "#bb9af7",
          "border": "rgb(236 240 247 / 0.08)",
          "input": "rgb(236 240 247 / 0.12)",
          "destructive": "#fb7185",
          "destructive-foreground": "var(--color-red-600)",
          "success": "#73daca",
          "success-foreground": "var(--color-emerald-600)",
          "warning": "#eaa518",
          "warning-foreground": "var(--color-yellow-600)",
          "invert": "var(--color-zinc-700)",
          "invert-foreground": "var(--color-zinc-50)",
          "sidebar-foreground": "#cad2db",
          "sidebar-primary": "#016f9f",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#0c1f31",
          "sidebar-accent-foreground": "#e8edf3",
          "sidebar-border": "transparent",
          "sidebar-ring": "#bb9af7",
          "chart-1": "#7aa2f7",
          "chart-2": "#9ece6a",
          "chart-3": "#41a6b5",
          "chart-4": "#7dcfff",
          "chart-5": "#9d7cd8",
          "chart-other": "#737aa2",
          "chart-hero": "#7aa2f7",
          "heatmap-0": "#172432",
          "heatmap-1": "#4d68a7",
          "heatmap-2": "#6183d1",
          "heatmap-3": "#7aa2f7",
          "heatmap-4": "#89ddff",
          "wave-deep": "#01294b",
          "wave-foam": "#d6f7f9",
          "mist": "#b5dde5"
        }
      },
      "css": {
        "@keyframes page-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(4px)"
          }
        },
        "@layer base": {
          ".dark": {
            "color-scheme": "dark",
            "--color-bg": "var(--background)",
            "--color-bg-accent": "color-mix(in oklch, var(--background) 74%, var(--primary) 26%)",
            "--color-surface": "color-mix(in oklch, var(--card) 90%, var(--background) 10%)",
            "--color-surface-muted": "var(--surface-muted)",
            "--color-surface-strong": "color-mix(in oklch, var(--card) 76%, var(--foreground) 24%)",
            "--color-surface-contrast": "color-mix(in oklch, var(--secondary) 82%, var(--primary) 18%)",
            "--color-card": "var(--card)",
            "--color-card-auth": "color-mix(in oklch, var(--card) 88%, var(--primary) 12%)",
            "--color-border": "var(--border)",
            "--color-border-strong": "color-mix(in oklch, var(--border) 55%, var(--primary) 45%)",
            "--color-text": "var(--foreground)",
            "--color-text-muted": "color-mix(in oklch, var(--foreground) 72%, var(--muted-foreground) 28%)",
            "--color-text-soft": "var(--muted-foreground)",
            "--color-primary": "var(--primary)",
            "--color-primary-strong": "color-mix(in oklch, var(--primary) 80%, white 20%)",
            "--color-primary-soft": "color-mix(in oklch, var(--primary) 26%, transparent)",
            "--color-primary-foreground": "var(--primary-foreground)",
            "--color-success": "var(--success)",
            "--color-success-soft": "color-mix(in oklch, var(--success) 24%, transparent)",
            "--color-warning": "var(--warning)",
            "--color-warning-soft": "color-mix(in oklch, var(--warning) 24%, transparent)",
            "--color-danger": "var(--destructive)",
            "--color-danger-soft": "color-mix(in oklch, var(--destructive) 24%, transparent)"
          },
          "@media (prefers-reduced-motion: reduce)": {
            "*, ::before, ::after": {
              "animation-duration": "0.01ms !important",
              "animation-iteration-count": "1 !important",
              "transition-duration": "0.01ms !important",
              "scroll-behavior": "auto !important"
            }
          }
        },
        "@utility type-display": {
          "font-family": "var(--font-heading)",
          "font-size": "clamp(2.25rem, 2vw + 1.5rem, 3rem)",
          "font-weight": "500",
          "line-height": "1.1"
        },
        "@utility type-headline": {
          "font-family": "var(--font-heading)",
          "font-size": "1rem",
          "font-weight": "500",
          "line-height": "1.375"
        },
        "@utility type-title": {
          "font-size": "0.875rem",
          "font-weight": "500",
          "line-height": "1.25"
        },
        "@utility type-body": {
          "font-size": "clamp(15px, 0.28vw + 14px, 16px)",
          "font-weight": "400",
          "line-height": "1.5"
        },
        "@utility type-label": {
          "font-size": "0.875rem",
          "font-weight": "500",
          "line-height": "1.25"
        },
        "@utility type-caption": {
          "font-size": "0.75rem",
          "font-weight": "500",
          "line-height": "1rem"
        }
      }
    }
  ]
}
