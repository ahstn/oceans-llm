        "crates/gateway-store/src/libsql_store/{mod,support}.rs",
        "crates/gateway-store/migrations/**",
        "crates/gateway/src/local_demo_seed/mod.rs",
        "gateway.yaml",
        "mise.toml",
        "Cargo.toml",
        "Cargo.lock",
        ".agents/skills/verify-oceans-admin/scripts/control-oceans-admin"
      ]
    },
    {
      "reason": "core inference path reaches every live request",
      "features": [
        "live-llm-requests",
        "request-logs"
