        "crates/admin-ui/web/src/router.tsx",
        "crates/admin-ui/web/src/routeTree.gen.ts",
        "crates/admin-ui/web/src/server/**",
        "crates/admin-ui/web/src/lib/**",
        "crates/admin-ui/web/src/hooks/**",
        "crates/admin-ui/web/src/styles/**",
        "crates/admin-ui/web/src/types/**",
        "crates/admin-ui/web/src/generated/**",
        "crates/admin-ui/web/*.{json,ts,lock}",
