        "crates/admin-ui/Cargo.toml",
        "crates/gateway/src/http/mod.rs",
        "crates/gateway/src/http/state.rs",
        "crates/gateway/src/http/error.rs",
        "crates/gateway/src/http/admin_contract.rs",
        "crates/gateway/src/config/**",
