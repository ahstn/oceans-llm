{
  "baseRefs": [
    "origin/main",
    "main"
  ],
  "skip": [
    {
      "reason": "tests only; CI covers them",
      "paths": [
        "**/*.test.{ts,tsx,mjs,js}",
        "**/*_tests.rs",
        "**/tests.rs",
        "**/tests/**",
        "**/test_support.rs",
        "crates/admin-ui/web/e2e/**",
        "crates/admin-ui/web/src/test/**",
        "crates/gateway-store/src/agent_analysis_tests.rs",
        "crates/gateway-store/src/budget_reconciliation_tests.rs"
      ]
    },
    {
      "reason": "documentation only",
      "paths": [
        "docs/**",
        "*.md",
        "crates/**/*.md",
        ".github/**/*.md",
        ".agents/skills/verify-oceans-admin/**/*.md"
      ]
    },
    {
      "reason": "Postgres store; the local stack runs libSQL",
      "paths": [
        "crates/gateway-store/src/postgres_store/**"
      ]
    },
    {
      "reason": "release, CI, or deployment tooling with no local runtime surface",
      "paths": [
        ".github/**",
        "deploy/**",
        "actions/**",
        "gha-research/**",
        "cliff.toml",
        "cog.toml",
        "skills-lock.json",
        "rust-analyzer.toml",
        "crates/admin-ui/web/Dockerfile"
      ]
    },
    {
      "reason": "verification planner and proof tooling; covered by their offline tests",
      "paths": [
        ".agents/skills/verify-oceans-admin/features/routing.json",
        ".agents/skills/verify-oceans-admin/scripts/{plan-verification,proof,proof-cli}.mjs"
      ]
    },
    {
      "reason": "agent harness and repository wiring",
      "paths": [
        ".claude/skills/**",
        ".claude/skills/*",
        ".gitignore",
        ".gitattributes"
      ]
    }
  ],
  "shared": [
    {
      "reason": "admin shell, nav, auth routing, and shared data loaders reach every page",
      "features": [
        "password-sign-in",
        "models",
        "leaderboard"
      ],
      "paths": [
        "crates/admin-ui/web/src/components/layout/**",
        "crates/admin-ui/web/src/components/app-sidebar.tsx",
        "crates/admin-ui/web/src/components/ui/**",
